{
  "compilerOptions": {
    /* ECMAScript & Module Settings */
    "target": "ESNext",
    "module": "NodeNext",
    /* Type Checking */
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    // "erasableSyntaxOnly": true // Stricter enforcement of TypeScript-only syntax TS 5.8 onwards
    /* Project Structure */
    "rootDir": "src",
    "outDir": "dist",
    /* Import & Module Handling */
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
    /* Performance */
    "skipLibCheck": true
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}